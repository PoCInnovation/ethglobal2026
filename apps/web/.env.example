# Ledger Developer Portal origin token (public client identifier, not a secret)
# Get your API key from the Ledger Developer Portal
VITE_LEDGER_API_KEY=

# Backend API URL (optional)
# - On Vercel: leave empty to use same-origin /api/* serverless functions
# - For local dev with Express backend: set to http://localhost:3005
VITE_BACKEND_URL=

# Vite dev only: proxy /api → local serverless. Run `vercel dev` in apps/web (default port 3000), then:
# BACKEND_URL=http://127.0.0.1:3000
# Without this, http://localhost:5173/api/* returns 404 (SPA does not implement /api).
BACKEND_URL=

# Optional: Override Base mainnet JSON-RPC (chainId 8453)
# Example: https://base-mainnet.g.alchemy.com/v2/<API_KEY>
VITE_BASE_MAINNET_RPC_URL=

# Optional: Override Polygon JSON-RPC (chainId 137)
# Example: https://polygon-mainnet.g.alchemy.com/v2/<API_KEY>
VITE_POLYGON_RPC_URL=

# Optional: Use the ledger-button-core stub dAppConfig (local/dev only).
# If enabled, device signing uses the stubbed appDependencies instead of fetching `/config`.
VITE_LEDGER_STUB_DAPP_CONFIG=false

# Polymarket — Oracle CRE contract address on Polygon (set when deployed)
# ORACLE_CRE_ADDRESS=0x...

# Neon / Vercel Postgres connection strings
# Required for all API routes. Provided automatically when using the Vercel Postgres integration.
# For local development, copy from your Neon dashboard or Vercel project settings.
# POSTGRES_URL=postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/dbname?sslmode=require
# POSTGRES_URL_NON_POOLING=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
